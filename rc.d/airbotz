#!/bin/sh
#
# PROVIDE: airbotz
# REQUIRE: LOGIN
# KEYWORD: shutdown
#
# Add airbotz_enable="YES" to /etc/rc.conf to enable this service.

. /etc/rc.subr

name="airbotz"
rcvar="airbotz_enable"

load_rc_config "$name"
: ${airbotz_enable:="NO"}
: ${airbotz_config:="/usr/local/etc/airbotz/airbotz.conf"}

# FreeBSD rc.subr does not implement command_background.
# Use daemon(8) to detach and maintain the child PID file.
command="/usr/sbin/daemon"
command_args="-f -p /var/run/airbotz.pid /usr/local/sbin/airbotz -c ${airbotz_config}"
pidfile="/var/run/airbotz.pid"
procname="/usr/local/sbin/airbotz"
required_files="${airbotz_config}"

run_rc_command "$1"
